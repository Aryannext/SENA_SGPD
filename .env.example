# ─────────────────────────────────────────────────────────────────────────────
# SGPD SENA — variables de entorno
#
# En local: copia este archivo a .env y ajusta lo que necesites.
# En Dokploy: pega estas claves en la seccion Environment del servicio.
#
# .env NUNCA se versiona (esta en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicacion ───────────────────────────────────────────────────────────────
# Subdirectorio en el que vive, SIN barra final.
#   vacio         -> raiz de un dominio o subdominio (el caso en Docker)
#   /SENA_SGPD    -> subcarpeta de XAMPP en local
APP_BASE_PATH=

# Donde se guardan los archivos subidos y el audio generado.
# En Docker debe apuntar a un volumen montado, o los archivos se pierden en
# cada despliegue.
APP_STORAGE_PATH=/var/www/html/storage

# Tamano maximo de los archivos que se pueden subir, en megabytes.
APP_MAX_UPLOAD_MB=20

# Mostrar errores en pantalla. En produccion SIEMPRE false: los mensajes de
# excepcion filtran rutas del sistema y estructura de la base de datos.
APP_DEBUG=false

# ── Base de datos ────────────────────────────────────────────────────────────
DB_HOST=sgpd-db
DB_PORT=3306
DB_NAME=sistema_sena
DB_USER=sgpd
DB_PASSWORD=cambia-esta-contrasena

# ── Inteligencia artificial (opcional) ───────────────────────────────────────
# RNF-11: el proveedor DEBE permanecer local. El contexto que se envia al modelo
# incluye datos personales de aprendices; apuntar esto a un servicio en la nube
# convierte el sistema en un exportador de datos personales sin base legal.
#
# En un VPS compartido lo normal es que no haya RAM para el modelo (~6 GB).
# Si no responde, el chat avisa y el resto del sistema sigue funcionando.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=4096

# ── Sintesis de voz (opcional) ───────────────────────────────────────────────
TTS_URL=http://127.0.0.1:5050
TTS_LANGUAGE=es
TTS_MAX_TEXT_LEN=500
